
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Damian Hernandez | Creative Portfolio</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">

<style>
:root {
  --background: #f6f5f1;
  --text: #20201e;
  --muted: #77756f;
  --accent: #b7a58b;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--background);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 27px 6%;
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(246,245,241,.94);
  backdrop-filter: blur(12px);
}

.logo {
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 1px;
}

.nav-links {
  display: flex;
  gap: 30px;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.nav-links a:hover {
  opacity: .5;
}

section {
  padding: 100px 8%;
}

.eyebrow {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--muted);
}

.hero {
  min-height: 650px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 120px 10%;
}

.hero h1 {
  font-size: clamp(55px, 10vw, 130px);
  line-height: .95;
  letter-spacing: -7px;
  font-weight: 500;
  margin: 35px 0;
}

.hero h1 em {
  font-family: 'Playfair Display', serif;
  font-weight: 500;
}

.hero-description {
  max-width: 460px;
  font-size: 17px;
  line-height: 1.7;
  color: var(--muted);
  margin-left: 5px;
}

.hero-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 75px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

.projects-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 55px;
}

.projects-heading h2,
.community h2,
.mock h2 {
  font-size: clamp(38px, 6vw, 75px);
  font-weight: 500;
  letter-spacing: -3px;
}

.project {
  margin-bottom: 100px;
}

.project-image {
  width: 100%;
  height: 490px;
  background: #e4e0d8;
  overflow: hidden;
  position: relative;
}

.project-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .7s ease;
}

.project:hover .project-image img {
  transform: scale(1.035);
}

.project-info {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  padding-top: 24px;
}

.project-info h3 {
  font-size: 25px;
  font-weight: 500;
  margin-bottom: 12px;
}

.project-info p {
  color: var(--muted);
  max-width: 510px;
  font-size: 14px;
  line-height: 1.7;
}

.view-work {
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  align-self: start;
  border-bottom: 1px solid var(--text);
  padding-bottom: 7px;
  white-space: nowrap;
}

.community {
  background: #e9e6df;
  padding: 130px 10%;
}

.community-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

.community h2 {
  margin: 25px 0;
  max-width: 520px;
}

.community p {
  color: #66635d;
  font-size: 16px;
  line-height: 1.9;
}

.community-image {
  height: 450px;
  background: #d3cec4;
  overflow: hidden;
}

.community-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin-top: 65px;
}

.gallery img {
  width: 100%;
  height: 310px;
  object-fit: cover;
  background: #e4e0d8;
}

.mock {
  padding-top: 130px;
  padding-bottom: 140px;
}

.mock p {
  max-width: 650px;
  color: var(--muted);
  line-height: 1.9;
  margin-top: 25px;
}

.mock-gallery {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 55px;
}

.mock-gallery img {
  width: 100%;
  height: 440px;
  object-fit: cover;
  background: #e4e0d8;
}

footer {
  background: #22221f;
  color: #f6f5f1;
  padding: 100px 8% 35px;
}

footer h2 {
  font-size: clamp(45px, 8vw, 95px);
  font-weight: 500;
  letter-spacing: -5px;
  margin: 25px 0;
}

footer a {
  border-bottom: 1px solid #aaa;
  padding-bottom: 5px;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 100px;
  padding-top: 25px;
  border-top: 1px solid #555;
  font-size: 11px;
  color: #aaa;
}

@media(max-width: 700px) {
  nav {
    padding: 22px 5%;
  }

  .nav-links {
    gap: 12px;
    font-size: 9px;
  }

  .hero {
    min-height: 580px;
    padding: 90px 7%;
  }

  .hero h1 {
    letter-spacing: -3px;
  }

  section {
    padding: 75px 7%;
  }

  .project-image {
    height: 300px;
  }

  .project-info {
    flex-direction: column;
  }

  .community-content {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .community-image {
    height: 330px;
  }

  .gallery {
    grid-template-columns: 1fr 1fr;
  }

  .gallery img {
    height: 200px;
  }

  .mock-gallery {
    grid-template-columns: 1fr;
  }

  .mock-gallery img {
    height: 330px;
  }

  .footer-bottom {
    flex-direction: column;
    gap: 15px;
  }
}
</style>
</head>

